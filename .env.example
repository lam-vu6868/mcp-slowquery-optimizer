# ============================================
# MCP SLOW QUERY OPTIMIZER — ENVIRONMENT TEMPLATE
# Cập nhật: 29/09/2026
# ============================================
# Hướng dẫn:
#   1. Copy file này thành .env:  copy .env.example .env
#   2. Điền giá trị thật vào .env
#   3. KHÔNG commit file .env lên Git
# ============================================

# ---------- DATABASE ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopdb

# User read-only (Tool 1-5 dùng)
DB_USER=readonly_user
DB_PASSWORD=readonly_pass

# User admin (CHỈ Tool 6 apply_optimization dùng)
# Chỉ có quyền CREATE/DROP/ALTER INDEX
DB_ADMIN_USER=index_admin
DB_ADMIN_PASSWORD=admin_pass

# ---------- LLM API ----------
# Anthropic (khuyến nghị)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (tùy chọn backup)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Provider chính: anthropic | openai
LLM_PROVIDER=anthropic

# Model: claude-sonnet-4-5 | claude-opus-4 | gpt-4o-mini
LLM_MODEL=claude-sonnet-4-5

# Temperature thấp để Consistency Rate ổn định
# 0.0 = deterministic nhất (khuyến nghị cho đánh giá)
LLM_TEMPERATURE=0.0

# Số token tối đa cho 1 lần phản hồi
LLM_MAX_TOKENS=2000

# Retry khi JSON output không hợp lệ
LLM_MAX_RETRIES=2

# ---------- SECURITY ----------
# Secret để sinh approval token HMAC
# Tạo bằng lệnh: python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING

# Thời gian hết hạn của approval token (giây)
APPROVAL_TOKEN_TTL=600

# ---------- APP ----------
LOG_LEVEL=INFO
SLOW_QUERY_THRESHOLD=0.5

# Giới hạn thời gian chạy query (mili giây)
MAX_EXECUTION_TIME=30000

# Số lần đo benchmark
BENCHMARK_WARMUP_RUNS=3
BENCHMARK_MEASURED_RUNS=20

# ---------- SEED DATA ----------
# Quy mô seed: 5m | 12m
# 5m  = 5M orders (~ yêu cầu tối thiểu của đề)
# 12m = 12M orders (giống case study Black Friday)
SEED_SCALE=12m

# Số user seed
SEED_USERS=1000000

# Random seed để tái lập kết quả
SEED_RANDOM_SEED=42

# ---------- DASHBOARD ----------
STREAMLIT_PORT=8501
STREAMLIT_HEADLESS=false

# ---------- PATHS ----------
SLOW_LOG_FILE=/var/log/mysql/slow.log
DATA_DIR=./data/outputs