# ============================================
# MCP SLOW QUERY OPTIMIZER — MYSQL CONFIG
# Cập nhật: 30/09/2026
# Mount vào /etc/mysql/conf.d/my.cnf trong container
# ============================================

[mysqld]
# ---------- SLOW QUERY LOG ----------
slow_query_log = 1
long_query_time = 0.5
slow_query_log_file = /var/lib/mysql/slow.log
log_output = FILE,TABLE
log_queries_not_using_indexes = 0
min_examined_row_limit = 0

# ---------- CONNECTION ----------
max_connections = 200
max_connect_errors = 1000
wait_timeout = 28800
interactive_timeout = 28800

# ---------- INNODB (cho benchmark ổn định) ----------
# Buffer pool 1GB để dữ liệu nằm trong RAM, tránh I/O làm nhiễu latency
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 4

# Tắt adaptive hash index để kết quả benchmark ổn định hơn
innodb_adaptive_hash_index = OFF

# Cho phép tạo index online (không block query)
innodb_online_alter_log_max_size = 512M

# Flush ổn định
innodb_flush_log_at_trx_commit = 2
sync_binlog = 0

# ---------- QUERY EXECUTION ----------
# Timeout query — bảo vệ hệ thống khỏi query treo (30s)
max_execution_time = 30000

# Bật performance_schema để track query stats
performance_schema = ON
performance_schema_instrument = 'statement/%=ON'
performance_schema_consumer_events_statements_current = ON
performance_schema_consumer_events_statements_history = ON
performance_schema_consumer_events_statements_history_long = ON

# ---------- CHARACTER SET ----------
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci

# ---------- LOGGING ----------
general_log = 0
general_log_file = /var/lib/mysql/general.log

# ---------- SAFETY ----------
# Bật local_infile để hỗ trợ nạp dữ liệu seed
local_infile = 1

[client]
default_character_set = utf8mb4

[mysql]
default_character_set = utf8mb4