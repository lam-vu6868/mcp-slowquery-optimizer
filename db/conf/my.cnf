# ============================================
# MCP SLOW QUERY OPTIMIZER — MYSQL CONFIG
# Cập nhật: 30/09/2026
# Mount vào /etc/mysql/conf.d/my.cnf trong container
# ============================================

[mysqld]
# ---------- SLOW QUERY LOG ----------
slow_query_log = 1
long_query_time = 0.5
#slow_query_log_file = /var/log/mysql/slow.log #dòng cũ
slow_query_log_file = /var/lib/mysql/slow.log #dòng mới
log_output = FILE,TABLE
log_queries_not_using_indexes = 0
min_examined_row_limit = 0

# ---------- CONNECTION ----------
max_connections = 200
max_connect_errors = 1000
wait_timeout = 28800
interactive_timeout = 28800

# ---------- INNODB (cho benchmark ổn định) ----------
# Buffer pool lớn để dữ liệu nằm trong RAM, tránh I/O làm nhiễu latency
innodb_buffer_pool_size = 2G
innodb_buffer_pool_instances = 4

# Tắt adaptive hash index để kết quả benchmark ổn định hơn
# (AHI có thể làm latency thay đổi ngẫu nhiên giữa các lần chạy)
innodb_adaptive_hash_index = OFF

# Cho phép tạo index online (không block query)
innodb_online_alter_log_max_size = 512M

# Flush ổn định
innodb_flush_log_at_trx_commit = 2
sync_binlog = 0

# ---------- QUERY EXECUTION ----------
# Timeout query — bảo vệ hệ thống khỏi query treo
max_execution_time = 30000

# Tắt cache query (MySQL 8 đã bỏ query_cache, dùng performance_schema)
# performance_schema bật để track query stats
performance_schema = ON
performance-schema-instrument = 'statement/%=ON'
performance-schema-consumer-events-statements-current = ON
performance-schema-consumer-events-statements-history = ON
performance-schema-consumer-events-statements-history-long = ON

# ---------- CHARACTER SET ----------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# ---------- LOGGING ----------
general_log = 0
#general_log_file = /var/log/mysql/general.log #dòng cũ
general_log_file = /var/lib/mysql/general.log #dòng mới

# ---------- SAFETY ----------
# Chặn query nguy hiểm nếu lỡ chạy
#sql_safe_updates = 1 
#Chú thích dòng sql_safe_updates = 1 vì là biến cấu hình theo phiên làm việc nên MySQL không cho phép đặt biến này làm tham số khởi động hệ thống trong file my.cnf

# Không cho dùng LOCAL INFILE nếu không cần (tắt để an toàn, mở khi seed)
local_infile = 1  #BẬT KHI CHẠY SEED 

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4